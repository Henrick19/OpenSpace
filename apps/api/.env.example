# Local service
PORT=8787
WEB_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/database/openspace.sqlite
UPLOAD_DIRECTORY=./data/uploads
MAX_UPLOAD_BYTES=21474836480

# Keep mock mode enabled until an authorised live test is approved.
OPENSPACE_MODE=mock
OPENSPACE_BASE_URL=https://sgp.openspace.ai
OPENSPACE_WEB_URL=https://sgp.openspace.ai/login
OPENSPACE_AUTH_URL=https://login.openspace.ai/oauth/token
OPENSPACE_CLIENT_ID=
OPENSPACE_CLIENT_SECRET=
OPENSPACE_USERNAME=
OPENSPACE_PASSWORD=
OPENSPACE_STATUS_POLL_INTERVAL_MS=15000
OPENSPACE_STATUS_POLL_TIMEOUT_MS=86400000

# Optional first camera identity. On startup it is imported into the local
# camera catalogue; add further cameras from the Catalogue screen.
OPENSPACE_DEFAULT_DEVICE_ID=

# Development behaviour
MOCK_UPLOAD_STEP_DELAY_MS=250
MOCK_PROCESSING_DELAY_MS=1500
